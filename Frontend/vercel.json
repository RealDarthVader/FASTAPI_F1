{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(races|drivers|favorites|search|docs|openapi.json)(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "Frontend/$1"
    }
  ]
}